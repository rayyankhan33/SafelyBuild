# Copy to .env (git-ignored). Everything has a development default except JWT_SECRET in production.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safelybuild
JWT_SECRET=change-me-in-production
INFERENCE_URL=http://localhost:8000
STORAGE_DIR=./storage
PORT=4000
# CORS_ORIGIN=http://localhost:5173
# Site local time offset from UTC in hours (frame dates, "today" and forecasts use it)
# SITE_UTC_OFFSET_HOURS=5
# Frames whose camera clock differs from the server by more than this are refused
# MAX_CLOCK_SKEW_MS=600000
# MAX_FRAMES_PER_CAMERA_PER_DAY=200
# Inference service: pick the active backend per task (see docs/model-integration.md)
# BACKEND_STAGE=classical_color
# BACKEND_INVENTORY=classical_color
# BACKEND_DEFECTS=opencv_tiles
# ENABLE_DEMO_FRAMES=1   # only for building demo data; never in production
# AI assistant (read-only agent; off by default). Keys stay in .env, which is git-ignored: never commit them.
# With AGENT_PROVIDER=gemini, project numbers and text are sent to Google (see docs/tool-disclosure.md).
# AGENT_ENABLED=1
# AGENT_PROVIDER=gemini            # default: gemini when GEMINI_API_KEYS is set, otherwise "offline" (no model, read-out only)
# GEMINI_API_KEYS=key1,key2,key3   # comma-separated; the next key is used when one is rate-limited
# GEMINI_MODEL=gemini-3.5-flash-lite   # any current Gemini model with function calling
# GEMINI_THINKING_LEVEL=MINIMAL    # optional, Gemini 3+ only: lower = faster
# AGENT_DAILY_BRIEFS=0             # turn off the automatic daily brief
# AGENT_TRIAGE=0                   # turn off automatic triage of doubtful frames
# AGENT_DAILY_RUN_LIMIT=100        # assistant runs per project per day (free-tier quota guard)
