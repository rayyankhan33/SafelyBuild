# Copy to .env (git-ignored). Everything has a development default except JWT_SECRET in production.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safelybuild
JWT_SECRET=change-me-in-production
INFERENCE_URL=http://localhost:8000
STORAGE_DIR=./storage
PORT=4000
# CORS_ORIGIN=http://localhost:5173
# Site local time offset from UTC in hours (frame dates, "today" and forecasts use it)
# SITE_UTC_OFFSET_HOURS=5
# Frames whose camera clock differs from the server by more than this are refused
# MAX_CLOCK_SKEW_MS=600000
# MAX_FRAMES_PER_CAMERA_PER_DAY=200
# Inference service: pick the active backend per task (see docs/model-integration.md)
# BACKEND_STAGE=classical_color
# BACKEND_INVENTORY=classical_color
# BACKEND_DEFECTS=opencv_tiles
# ENABLE_DEMO_FRAMES=1   # only for building demo data; never in production
